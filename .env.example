# 服务端口
PORT=8787

# 监听地址；局域网使用 0.0.0.0
HOST=0.0.0.0

# 数据目录（SQLite + 图片）
DATA_DIR=./data

# 自动探测的局域网 IP 不对时，手动指定复制出去的地址
# PUBLIC_BASE_URL=http://192.168.1.23:8787

# 可选：固定主机密钥；不填则自动生成到 data/host-key.txt
# HOST_KEY=change-me

# 单文件 exe / Go 版本启动时是否自动打开浏览器；0 = 不打开
# LANPAD_OPEN=1

# Go 版本：.env 和相对路径的锚点（默认当前工作目录）
# LANPAD_ROOT=D:\LANPad

# Go 版本：前端构建产物目录（默认 ./dist/client）
# CLIENT_DIR=./dist/client
